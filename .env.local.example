# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY  # 서버 전용. NEXT_PUBLIC_ 접두사 금지

# 카카오 OAuth (Supabase Dashboard > Auth > Providers 에서 설정)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 OAuth (Supabase native 미지원 - Custom OIDC 또는 자체 라우트 구현 필요)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 지도
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 기타
NEXT_PUBLIC_SITE_URL=http://localhost:3000
